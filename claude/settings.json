{
  "model": "opus[1m]",
  "enabledPlugins": {
    "appfolio-jira-tools@appfolio-dev-tools-marketplace": true
  },
  "extraKnownMarketplaces": {
    "appfolio-dev-tools-marketplace": {
      "source": {
        "source": "github",
        "repo": "appfolio/ai-dev-tools"
      },
      "autoUpdate": true
    }
  },
  "alwaysThinkingEnabled": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/justin.maher/.claude/hooks/rtk-rewrite.sh"
          }
        ]
      }
    ]
  }
}