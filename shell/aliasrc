function pfp() {
  lsof -nP -iTCP:$1 | grep LISTEN
}

function ottosh() {
  export OTTO_DEVCONTAINER_DEFAULT_PROFILE=$1;
  export OTTO_DEVCONTAINER_DEFAULT_DETACH=true;
  exec $SHELL;
}

function tdiff() {
  git diff --name-only --diff-filter=ACMTUXB $@ | grep _test.rb | xargs test_launcher
}

function testAnyFile() {
  EXT="${1##*.}"

  if [[ $EXT =~ (j|t)sx? ]]; then
    npm run test:fast "${1}"
  else
    test_launcher "${1}"
  fi
}

function tf_override () {
  echo "Overriding terraform..."
  cp provider.tf provider_override.tf
  cp backend.tf backend_override.tf
  sed -i '' -Ee 's/arn:.*/"/g' backend_override.tf
  sed -i '' -Ee 's/arn:.*/"/g' provider_override.tf
}

function dcsh () {
  docker compose exec $1 bash
}

